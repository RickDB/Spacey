# Required. URL-encode reserved URL characters because this value is used in a PostgreSQL URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional.
SPACEY_PORT=18087
SPACEY_TAG=latest
TZ=Europe/Amsterdam
SPACEY_POSTGRES_VOLUME=spacey-postgres-data

# Only needed with compose.cleanup.yaml.
# SPACEY_CLEANUP_HOST_PATH=/mnt/tank/media
# SPACEY_UID=1000
# SPACEY_GID=1000
